generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ProformaStatus {
  DRAFT
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum AttachmentOwnerType {
  CLIENT
  PROFORMA
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  passwordHash String
  role         Role               @default(USER)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignments  ClientAssignment[]
  sessions     UserSession[]
  createdClients Client[]          @relation("ClientCreator")
  createdProformas Proforma[]      @relation("ProformaCreator")

  @@index([role])
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  tokenHash        String
  userAgent        String?
  ipAddress        String?
  remember         Boolean  @default(false)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Client {
  id          String             @id @default(uuid())
  name        String
  companyName String
  email       String?
  phone       String?
  country     String?
  notes       String?
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   User              @relation("ClientCreator", fields: [createdById], references: [id])
  assignments ClientAssignment[]
  proformas   Proforma[]
  attachments FileAttachment[]

  @@index([name])
  @@index([companyName])
  @@index([createdAt])
}

model ClientAssignment {
  id        String   @id @default(uuid())
  userId    String
  clientId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([clientId])
}

model Proforma {
  id              String           @id @default(uuid())
  clientId        String
  proformaNumber  String
  date            DateTime
  status          ProformaStatus   @default(DRAFT)
  currency        String           @default("USD")
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("ProformaCreator", fields: [createdById], references: [id])
  columns         CustomColumn[]
  rows            ArticleRow[]
  attachments     FileAttachment[]

  @@unique([clientId, proformaNumber])
  @@index([status])
  @@index([date])
  @@index([clientId])
}

model CustomColumn {
  id          String    @id @default(uuid())
  proformaId  String
  key         String
  name        String
  type        String    @default("text")
  position    Int
  hidden      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  proforma    Proforma  @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@unique([proformaId, key])
  @@index([proformaId, position])
}

model ArticleRow {
  id          String    @id @default(uuid())
  proformaId  String
  position    Int
  cells       Json      @default("{}")
  colors      Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  proforma    Proforma  @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId, position])
  @@index([updatedAt])
}

model FileAttachment {
  id          String              @id @default(uuid())
  clientId    String?
  proformaId  String?
  ownerType   AttachmentOwnerType
  fileName    String
  mimeType    String
  size        Int
  storagePath String
  uploadedBy  String
  createdAt   DateTime            @default(now())
  client      Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proforma    Proforma?           @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([proformaId])
}
