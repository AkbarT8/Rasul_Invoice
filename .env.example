# Database
# For local dev with SQLite (default):
DATABASE_URL="file:./dev.db"

# For production with PostgreSQL (Neon / Supabase / Railway):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT — generate a long random string for production!
# Example: openssl rand -base64 48
JWT_SECRET="change-me-in-production-please-use-a-long-random-string-here-min-32-chars"

# Initial admin (created by `npm run db:seed`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Uploads
# Max single file size in bytes (default 10 MB)
UPLOAD_MAX_BYTES=10485760

# Cookie settings
# Set to "true" in production behind HTTPS
COOKIE_SECURE="false"
